# Login shells (SSH, console, `bash -l`) read the first of ~/.bash_profile,
# ~/.bash_login, ~/.profile that exists — and then stop. Since the installer
# creates ~/.bash_profile, we must pull in the rest ourselves, or a login shell
# would lose the distro's ~/.profile setup (PATH for ~/.local/bin, etc.).
#
# So: source ~/.profile (which on Debian/Ubuntu also sources ~/.bashrc), then
# fall back to ~/.bashrc directly if .profile didn't load our config. The
# _DOTFILES_GUARD sentinel (set by bash/bashrc) means the body still runs at
# most once, however many of these paths reach it.
[ -f ~/.profile ] && . ~/.profile
[ -z "${_DOTFILES_GUARD:-}" ] && [ -f ~/.bashrc ] && . ~/.bashrc
