# Load this config at most once per shell. Some distros (Fedora, openSUSE) ship
# a ~/.bash_profile that sources ~/.bashrc, and our own ~/.bash_profile reaches
# ~/.bashrc again via ~/.profile — without this guard the body would run twice.
[ -n "${_DOTFILES_GUARD:-}" ] && return
_DOTFILES_GUARD=1

# Repo root, derived from this file's own location so sourcing works no matter
# where the repo is cloned (not just ~/dotfiles).
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Ensure ~/.local/bin is on PATH (idempotent — won't duplicate if already there).
# Most distros' ~/.profile does this for login shells; doing it here covers
# interactive non-login shells and minimal environments (containers, etc.).
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# LS_COLORS — rich file type coloring for ls
if command -v dircolors > /dev/null 2>&1; then
    eval "$(dircolors -b)"
fi

# Per-machine overrides (DOTFILES_LABEL, extra exports, etc.) — sourced FIRST so
# the prompt can pick up DOTFILES_LABEL. This file is untracked; see install.sh.
[ -f ~/.config/dotfiles/local.sh ] && source ~/.config/dotfiles/local.sh

# Prompt
source "$DOTFILES_DIR/bash/prompt.bash"

# Aliases
source "$DOTFILES_DIR/shell/aliases.sh"

# Count body executions. The guard above keeps this at 1 no matter how many
# times ~/.bashrc gets sourced during startup — the smoke test asserts it.
_DOTFILES_LOADED=$(( ${_DOTFILES_LOADED:-0} + 1 ))
